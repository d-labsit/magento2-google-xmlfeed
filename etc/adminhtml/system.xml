<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <!-- Section lives under Core's shared "Dlabsit" configuration tab. -->
        <section id="dlabsit_googlefeed" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Google Feed</label>
            <tab>dlabsit</tab>
            <resource>Dlabsit_GoogleFeed::config</resource>

            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Google Feed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, the feed is generated by cron and the CLI for this store view.</comment>
                </field>
                <field id="filename" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Feed Filename</label>
                    <comment>Written to pub/media/googlefeed/&lt;store-code&gt;/&lt;filename&gt; (default: google.xml).</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="store_name" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Feed Title</label>
                    <comment>RSS channel title. Empty = Magento store name.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="include_out_of_stock" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Out-of-Stock Products</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="cron_schedule" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInStore="0" showInWebsite="0">
                    <label>Cron Schedule</label>
                    <comment>Crontab expression. Default: 30 23 * * * (daily 23:30).</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="generate_now" translate="label" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Generate Now</label>
                    <frontend_model>Dlabsit\GoogleFeed\Block\Adminhtml\System\Config\GenerateButton</frontend_model>
                </field>
            </group>

            <group id="identity" translate="label comment" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Identity</label>
                <comment>How each product is identified. For products without a GTIN (common for auto parts), brand + MPN together are the identifier.</comment>
                <field id="unique_id_source" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product [id] Source</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\UniqueIdSource</source_model>
                    <comment>Fills g:id (max 50 chars, must be unique &amp; stable).</comment>
                </field>
                <field id="custom_attribute_code" translate="label" type="text" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom [id] Attribute Code</label>
                    <depends><field id="unique_id_source">custom</field></depends>
                </field>
                <field id="brand_attribute" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Brand Attribute</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>Maps to g:brand.</comment>
                </field>
                <field id="gtin_attribute" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>GTIN / EAN Attribute</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>Maps to g:gtin. Invalid GTINs (bad check digit) are dropped automatically.</comment>
                </field>
                <field id="mpn_attribute" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>MPN Attribute</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>Maps to g:mpn (default: sku).</comment>
                </field>
            </group>

            <group id="content" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Content &amp; Variants</label>
                <field id="description_source" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Description Source</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\DescriptionSource</source_model>
                </field>
                <field id="condition" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Condition</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\Condition</source_model>
                </field>
                <field id="color_attribute" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Color Attribute</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                </field>
                <field id="size_attribute" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Size Attribute</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                </field>
                <field id="default_gender" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Gender</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\Gender</source_model>
                </field>
                <field id="default_age_group" translate="label" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Age Group</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\AgeGroup</source_model>
                </field>
            </group>

            <group id="categorization" translate="label comment" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Google Product Category</label>
                <comment><![CDATA[Best practice: set a <b>Google Product Category</b> per Magento category (Catalog → Categories) — it is inherited by every product underneath and can be overridden per product. This default is the fallback when nothing is set on the category tree.]]></comment>
                <field id="default_google_category" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Google Product Category</label>
                    <comment>Numeric ID or full taxonomy path, e.g. "Vehicles &amp; Parts &gt; Vehicle Parts &amp; Accessories &gt; Motor Vehicle Parts".</comment>
                </field>
            </group>

            <group id="labels" translate="label comment" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Custom Labels</label>
                <comment>Each label is filled from a product attribute and maps to g:custom_label_0…4 — used to segment Shopping campaigns (e.g. vehicle make, price tier, margin, position L/R).</comment>
                <field id="custom_label_0" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>custom_label_0</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                </field>
                <field id="custom_label_1" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>custom_label_1</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                </field>
                <field id="custom_label_2" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>custom_label_2</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                </field>
                <field id="custom_label_3" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>custom_label_3</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                </field>
                <field id="custom_label_4" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>custom_label_4</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                </field>
            </group>

            <group id="details" translate="label comment" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Details &amp; Highlights</label>
                <comment>Structured specs — great for fitment ("Vehicle: VW Golf 6", "Position: Left").</comment>
                <field id="detail_attributes" translate="label comment" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product Detail Attributes</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributesMulti</source_model>
                    <comment>Each selected attribute is emitted as a g:product_detail entry (name = attribute label, value = product value).</comment>
                </field>
                <field id="highlight_attribute" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product Highlight Attribute</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>A text attribute; each line becomes a g:product_highlight bullet.</comment>
                </field>
            </group>

            <group id="dimensions" translate="label comment" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Weight &amp; Dimensions</label>
                <comment>Dimensions are only emitted when the mapped attribute has a value.</comment>
                <field id="weight_attribute" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Weight Attribute</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>Maps to g:shipping_weight (default: weight).</comment>
                </field>
                <field id="include_shipping_weight" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Export Shipping Weight</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="length_attribute" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Length Attribute (cm)</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>Maps to g:product_length.</comment>
                </field>
                <field id="width_attribute" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Width Attribute (cm)</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>Maps to g:product_width.</comment>
                </field>
                <field id="height_attribute" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Height Attribute (cm)</label>
                    <source_model>Dlabsit\GoogleFeed\Model\Config\Source\ProductAttributes</source_model>
                    <comment>Maps to g:product_height.</comment>
                </field>
            </group>

            <group id="shipping" translate="label comment" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Shipping (optional)</label>
                <comment>When a country and price are set, a g:shipping node is added to every item.</comment>
                <field id="country" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Country (ISO 3166 code)</label>
                    <comment>e.g. NL, DE, GR.</comment>
                </field>
                <field id="service" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Service name</label>
                </field>
                <field id="price" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Shipping Price</label>
                    <comment>Numeric, in the store currency (e.g. 4.95).</comment>
                </field>
            </group>
        </section>
    </system>
</config>

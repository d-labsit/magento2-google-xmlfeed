{
    "name": "dlabsit/module-google-feed",
    "description": "Generates a spec-compliant Google Merchant Center (Google Shopping) product feed for Magento 2. Streaming XMLWriter, store-view configurable, CLI + cron generation.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Dlabs IT",
            "email": "info@dlabs.nl",
            "homepage": "https://dlabs.nl"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "dlabsit/module-core": "^1.0",
        "magento/framework": ">=103.0.0",
        "magento/module-catalog": ">=104.0.0",
        "magento/module-store": ">=101.0.0",
        "magento/module-eav": ">=102.0.0",
        "magento/module-config": ">=101.2.0",
        "magento/module-catalog-inventory": ">=100.4.0",
        "magento/module-configurable-product": ">=100.4.0"
    },
    "require-dev": {
        "magento/magento-coding-standard": "^40",
        "phpstan/phpstan": "^1.12",
        "bitexpert/phpstan-magento": "^0.11",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Dlabsit\\GoogleFeed\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dlabsit\\GoogleFeed\\Test\\": "Test/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=Magento2 --severity=8 --extensions=php,phtml .",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "ci": ["@lint", "@phpstan", "@test"]
    },
    "keywords": ["magento", "magento2", "google-shopping", "google-merchant", "product-feed", "xml-feed"]
}
